<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GymFit - Best Gym in Town</title>
  <link rel="stylesheet" href="styles1.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-container">
      <a href="#" class="navbar-logo">GymFit</a>
      <ul class="navbar-menu">
        <li><a href="#home" class="navbar-link">Home</a></li>
        <li><a href="#about" class="navbar-link">About</a></li>
        <li><a href="#services" class="navbar-link">Services</a></li>
        <li><a href="#testimonials" class="navbar-link">Testimonials</a></li>
        <li><a href="#contact" class="navbar-link">Contact</a></li>
      </ul>
      <button class="navbar-toggle" id="mobile-menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>

  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="hero-content">
      <h1>Transform Your Body, Transform Your Life</h1>
      <p>Join GymFit today and achieve your fitness goals with our expert trainers and state-of-the-art facilities.</p>
      <a href="#services" class="btn">Get Started</a>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about">
    <div class="about-container">
      <div class="about-image">
        <img src="https://via.placeholder.com/400" alt="About Us">
      </div>
      <div class="about-text">
        <h2>About Us</h2>
        <p>At GymFit, we are committed to helping you achieve your fitness goals. Our team of certified trainers and nutritionists will guide you every step of the way.</p>
        <a href="#contact" class="btn">Learn More</a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="services">
    <h2>Our Services</h2>
    <div class="services-container">
      <div class="service-card">
        <i class="fas fa-dumbbell"></i>
        <h3>Personal Training</h3>
        <p>Customized training programs tailored to your needs.</p>
      </div>
      <div class="service-card">
        <i class="fas fa-running"></i>
        <h3>Group Classes</h3>
        <p>Join our group classes for a fun and motivating workout.</p>
      </div>
      <div class="service-card">
        <i class="fas fa-heartbeat"></i>
        <h3>Nutrition Plans</h3>
        <p>Get personalized nutrition plans to complement your fitness journey.</p>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="testimonials">
    <h2>What Our Clients Say</h2>
    <div class="testimonials-container">
      <div class="testimonial-card">
        <p>"GymFit has transformed my life! The trainers are amazing and the facilities are top-notch."</p>
        <h4>- John Doe</h4>
      </div>
      <div class="testimonial-card">
        <p>"I love the group classes. They are so much fun and keep me motivated!"</p>
        <h4>- Jane Smith</h4>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="contact">
    <h2>Contact Us</h2>
    <div class="contact-container">
      <form action="#" method="post">
        <input type="text" name="name" placeholder="Your Name" required>
        <input type="email" name="email" placeholder="Your Email" required>
        <textarea name="message" placeholder="Your Message" required></textarea>
        <button type="submit" class="btn">Send Message</button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; 2023 GymFit. All rights reserved.Website by Aditya  Thakur </p>
    <div class="social-icons">
      <a href="#"><i class="fab fa-facebook"></i></a>
      <a href="#"><i class="fab fa-twitter"></i></a>
      <a href="#"><i class="fab fa-instagram"></i></a>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
